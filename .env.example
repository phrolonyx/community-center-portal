# Copier ce fichier en .env et ajuster au besoin.
# Ne jamais committer le fichier .env.

# Mot de passe root de MySQL (obligatoire)
DB_PASSWORD=changeme

# --- Optionnel : envoi réel de courriels en développement local (start.sh) ---
# Avec Docker, les courriels vont à Mailpit (http://localhost:8025) et ces
# valeurs sont ignorées. Avec Gmail, utiliser un « mot de passe d'application ».
# MAIL_USERNAME=
# MAIL_PASSWORD=
