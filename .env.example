# Copier ce fichier en .env et ajuster au besoin.
# Ne jamais committer le fichier .env.

# Mot de passe root de MySQL (obligatoire, administration seulement)
DB_ROOT_PASSWORD=changeme-root

# Mot de passe de l'utilisateur « manara » qu'utilise l'application (obligatoire)
# En développement local sans Docker, c'est le mot de passe
# de l'utilisateur défini par DB_USERNAME (root par défaut).
DB_PASSWORD=changeme

# --- Optionnel : envoi réel de courriels en développement local (sans Docker) ---
# Avec Docker, les courriels vont à Mailpit (http://localhost:8025) et ces
# valeurs sont ignorées. Avec Gmail, utiliser un « mot de passe d'application ».
# MAIL_USERNAME=
# MAIL_PASSWORD=
